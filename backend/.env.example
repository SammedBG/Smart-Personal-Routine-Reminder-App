# ──────────────────────────────────────────────
#  Smart Personal Routine Reminder — Environment
# ──────────────────────────────────────────────

# Environment: development | staging | production
ENVIRONMENT=development
DEBUG=false

# Database (SQLite default for local dev; use PostgreSQL in production)
# DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/smart_routines
# SQLALCHEMY_ECHO=false

# JWT – generate strong random values for staging/production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
JWT_REFRESH_SECRET_KEY=CHANGE_ME_REFRESH

# Firebase – path to service account JSON for FCM push notifications
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# CORS – JSON list of allowed origins (optional)
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]
